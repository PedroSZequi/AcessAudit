@startuml componentes
title AccessAudit — Diagrama de Componentes

skinparam shadowing false
skinparam componentStyle rectangle

actor "Usuário" as user

[Frontend Web] as front

package "Backend (Spring Boot)" {
  [AuditoriaController\n(API REST)] as ctrl
  [AuditoriaService] as service
  [ColetorConteudo] as coletor
  [MotorAuditoria] as motor
  [Regras WCAG] as regras
  [AuditoriaRepository] as repo
}

database "AWS RDS\n(PostgreSQL)" as db

user --> front
front --> ctrl : HTTP / JSON
ctrl --> service
service --> coletor
service --> motor
service --> repo
motor --> regras
coletor ..> [Página externa] : HTTP GET
repo --> db : JDBC

@enduml
