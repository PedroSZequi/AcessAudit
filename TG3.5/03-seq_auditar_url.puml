@startuml seq_auditar_url
title AccessAudit — Sequência: Auditar página por URL

skinparam shadowing false

actor Usuário
participant "Frontend" as front
participant "AuditoriaController" as ctrl
participant "AuditoriaService" as service
participant "ColetorConteudo" as coletor
participant "MotorAuditoria" as motor
participant "AuditoriaRepository" as repo

Usuário -> front : informa URL e clica "Auditar"
front -> ctrl : POST /auditorias { tipo: URL, url }
ctrl -> service : executar(req)
service -> coletor : obterHtml(url)
coletor --> service : html
service -> motor : analisar(html)

loop para cada Regra
  motor -> motor : avaliar(documento)
end

motor --> service : List<ProblemaAcessibilidade>
service -> repo : save(auditoria)
repo --> service : auditoria persistida
service --> ctrl : Relatorio
ctrl --> front : 201 RelatorioResponse
front --> Usuário : exibe relatório

@enduml
